# ── Shopify (Commerce) ──
# Public — safe in client bundle
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_API_TOKEN=

# Server-only — never expose client-side
PRIVATE_STOREFRONT_API_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SESSION_SECRET=

# ── Sanity (Editorial) ──
# Server-only — never expose client-side
SANITY_PROJECT_ID=2wo9hx90
SANITY_ORGANIZATION_ID=o9GdYjNoE
SANITY_DATASET=production
SANITY_API_VERSION=2026-06-01
# Optional public/read token for private datasets or server-only reads.
SANITY_API_READ_TOKEN=
# Viewer token used only server-side to enable Sanity Presentation/preview mode.
SANITY_PREVIEW_TOKEN=
# Studio origin used by stega/visual editing during preview.
SANITY_STUDIO_URL=http://localhost:3333
# Legacy preview secret kept only for older custom preview flows.
SANITY_PREVIEW_SECRET=

# ── Shopify Admin (Server-side scripts only) ──
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-04
