en": [{"_key": "series-opening-drop-34-61", "_type": "span", "text": "This series is for people who know a wall can remember.", "marks": []}], "markDefs": []}], "status": "live", "shopifyCollectionHandle": "opening-drop", "seo": {"metaTitle": "Opening Drop - Kumachi Prints", "metaDescription": "The first Kumachi Prints release: 22 curated open-drop African art prints on archival matte paper with pigment ink."}, "heroImage": {"_type": "imageWithAlt", "alt": ""}}
{"_id": "page-contact", "_type": "page", "title": "Contact", "slug": {"_type": "slug", "current": "contact"}, "body": [{"_key": "page-contact-0", "_type": "block", "style": "h1", "children": [{"_key": "page-contact-0-0", "_type": "span", "text": "Contact", "marks": []}], "markDefs": []}, {"_key": "page-contact-1", "_type": "block", "style": "normal", "children": [{"_key": "page-contact-1-1", "_type": "span", "text": "Some questions need a human answer.", "marks": []}], "markDefs": []}, {"_key": "page-contact-2", "_type": "block", "style": "normal", "children": [{"_key": "page-contact-2-2", "_type": "span", "text": "Use this page for order support, collector questions, print-size help, and press or collaboration notes. If you are asking about a specific work, include the title and size you are considering.", "marks": []}], "markDefs": []}, {"_key": "page-contact-3", "_type": "block", "style": "h2", "children": [{"_key": "page-contact-3-3", "_type": "span", "text": "Collector Help", "marks": []}], "markDefs": []}, {"_key": "page-contact-4", "_type": "block", "style": "normal", "children": [{"_key": "page-contact-4-4", "_type": "span", "text": "Ask about scale, placement, paper, shipping, or how a piece might sit in a room. A print should not arrive as a guess.", "marks": []}], "markDefs": []}, {"_key": "page-contact-5", "_type": "block", "style": "h2", "children": [{"_key": "page-contact-5-5", "_type": "span", "text": "Order Support", "marks": []}], "markDefs": []}, {"_key": "page-contact-6", "_type": "block", "style": "normal", "children": [{"_key": "page-contact-6-6", "_type": "span", "text": "For an existing order, include your order number and the email used at checkout.", "marks": []}], "markDefs": []}, {"_key": "page-contact-7", "_type": "block", "style": "h2", "children": [{"_key": "page-contact-7-7", "_type": "span", "text": "Studio And Press", "marks": []}], "markDefs": []}, {"_key": "page-contact-8", "_type": "block", "style": "normal", "children": [{"_key": "page-contact-8-8", "_type": "span", "text": "For Kumachi Studio, Tales of Kuma, press, or partnership inquiries, send a short note with the project, timeline, and the decision you need from us.", "marks": []}], "markDefs": []}, {"_key": "page-contact-9", "_type": "block", "style": "normal", "children": [{"_key": "page-contact-9-9", "_type": "span", "text": "Read the print quality guide", "marks": ["link-page-contact-9-10"]}, {"_key": "page-contact-9-11", "_type": "span", "text": " or ", "marks": []}, {"_key": "page-contact-9-12", "_type": "span", "text": "check shipping and returns", "marks": ["link-page-contact-9-13"]}, {"_key": "page-contact-9-14", "_type": "span", "text": ".", "marks": []}], "markDefs": [{"_key": "link-page-contact-9-10", "_type": "link", "url": "/pages/print-quality"}, {"_key": "link-page-contact-9-13", "_type": "link", "url": "/pages/shipping-returns"}]}], "seo": {"metaTitle": "Contact - Kumachi Prints", "metaDescription": "Contact Kumachi Prints for order support, collector questions, sizing help, press, and studio inquiries."}}
{"_id": "page-shipping-returns", "_type": "page", "title": "Shipping And Returns", "slug": {"_type": "slug", "current": "shipping-returns"}, "body": [{"_key": "page-shipping-returns-0", "_type": "block", "style": "h1", "children": [{"_key": "page-shipping-returns-0-0", "_type": "span", "text": "Shipping And Returns", "marks": []}], "markDefs": []}, {"_key": "page-shipping-returns-1", "_type": "block", "style": "normal", "children": [{"_key": "page-shipping-returns-1-1", "_type": "span", "text": "Each print is made after the order is placed.", "marks": []}], "markDefs": []}, {"_key": "page-shipping-returns-2", "_type": "block", "style": "normal", "children": [{"_key": "page-shipping-returns-2-2", "_type": "span", "text": "That means production comes first, then packing, then shipping. The print is not pulled from a warehouse shelf. It is produced for the order and handled as paper should be handled: carefully.", "marks": []}], "markDefs": []}, {"_key": "page-shipping-returns-3", "_type": "block", "style": "h2", "children": [{"_key": "page-shipping-returns-3-3", "_type": "span", "text": "Production", "marks": []}], "markDefs": []}, {"_key": "page-shipping-returns-4", "_type": "block", "style": "normal", "children": [{"_key": "page-shipping-returns-4-4", "_type": "span", "text": "Most launch prints are produced on demand. Production timing depends on print size, order volume, and fulfillment capacity.", "marks": []}], "markDefs": []}, {"_key": "page-shipping-returns-5", "_type": "block", "style": "h2", "children": [{"_key": "page-shipping-returns-5-5", "_type": "span", "text": "Shipping", "marks": []}], "markDefs": []}, {"_key": "page-shipping-returns-6", "_type": "block", "style": "normal", "children": [{"_key": "page-shipping-returns-6-6", "_type": "span", "text": "Shipping rates and timelines are shown at checkout. Larger prints may require different packaging than smaller prints. International buyers should allow extra time for customs and local delivery handling.", "marks": []}], "markDefs": []}, {"_key": "page-shipping-returns-7", "_type": "block", "style": "h2", "children": [{"_key": "page-shipping-returns-7-7", "_type": "span", "text": "Damage In Transit", "marks": []}], "markDefs": []}, {"_key": "page-shipping-returns-8", "_type": "block", "style": "normal", "children": [{"_key": "page-shipping-returns-8-8", "_type": "span", "text": "If a print arrives damaged, keep the packaging and photograph the damage clearly. Contact support with your order number, photos of the print, and photos of the packaging.", "marks": []}], "markDefs": []}, {"_key": "page-shipping-returns-9", "_type": "block", "style": "h2", "children": [{"_key": "page-shipping-returns-9-9", "_type": "span", "text": "Returns", "marks": []}], "markDefs": []}, {"_key": "page-shipping-returns-10", "_type": "block", "style": "normal", "children": [{"_key": "page-shipping-returns-10-10", "_type": "span", "text": "Because prints are produced for each order, returns should follow the active Shopify return policy shown at checkout. Before launch, this page must be checked against the live Shopify policy settings so the wording stays aligned.", "marks": []}], "markDefs": []}, {"_key": "page-shipping-returns-11", "_type": "block", "style": "normal", "children": [{"_key": "page-shipping-returns-11-11", "_type": "span", "text": "Contact us", "marks": ["link-page-shipping-returns-11-12"]}, {"_key": "page-shipping-returns-11-13", "_type": "span", "text": " if an order arrives wrong, damaged, or unclear.", "marks": []}], "markDefs": [{"_key": "link-page-shipping-returns-11-12", "_type": "link", "url": "/pages/contact"}]}], "seo": {"metaTitle": "Shipping And Returns - Kumachi Prints", "metaDescription": "Shipping, production, damage, and returns guidance for Kumachi Prints orders."}}
{"_id": "page-print-quality", "_type": "page", "title": "Print Quality", "slug": {"_type": "slug", "current": "print-quality"}, "body": [{"_key": "page-print-quality-0", "_type": "block", "style": "h1", "children": [{"_key": "page-print-quality-0-0", "_type": "span", "text": "Print Quality", "marks": []}], "markDefs": []}, {"_key": "page-print-quality-1", "_type": "block", "style": "normal", "children": [{"_key": "page-print-quality-1-1", "_type": "span", "text": "The print should hold the work without pretending to be the original.", "marks": []}], "markDefs": []}, {"_key": "page-print-quality-2", "_type": "block", "style": "normal", "children": [{"_key": "page-print-quality-2-2", "_type": "span", "text": "Every launch print is produced on archival matte paper with pigment ink. The surface is chosen for color, detail, and a quiet finish that does not fight the image.", "marks": []}], "markDefs": []}, {"_key": "page-print-quality-3", "_type": "block", "style": "h2", "children": [{"_key": "page-print-quality-3-3", "_type": "span", "text": "Paper", "marks": []}], "markDefs": []}, {"_key": "page-print-quality-4", "_type": "block", "style": "normal", "children": [{"_key": "page-print-quality-4-4", "_type": "span", "text": "The launch paper is heavyweight matte stock. It gives portraits, linework, landscape, and flat color enough body to sit cleanly behind glass or in a simple frame.", "marks": []}], "markDefs": []}, {"_key": "page-print-quality-5", "_type": "block", "style": "h2", "children": [{"_key": "page-print-quality-5-5", "_type": "span", "text": "Ink", "marks": []}], "markDefs": []}, {"_key": "page-print-quality-6", "_type": "block", "style": "normal", "children": [{"_key": "page-print-quality-6-6", "_type": "span", "text": "Pigment ink is used for depth and longevity. It is the right choice for work that depends on strong color fields, fine linework, and skin, sky, animal, and shadow tones that need to stay steady.", "marks": []}], "markDefs": []}, {"_key": "page-print-quality-7", "_type": "block", "style": "h2", "children": [{"_key": "page-print-quality-7-7", "_type": "span", "text": "Framing", "marks": []}], "markDefs": []}, {"_key": "page-print-quality-8", "_type": "block", "style": "normal", "children": [{"_key": "page-print-quality-8-8", "_type": "span", "text": "Launch prints ship unframed. This keeps the work easier to ship and gives collectors control over the frame. Use a frame that matches the print size exactly, or take larger pieces to a local framer for matting.", "marks": []}], "markDefs": []}, {"_key": "page-print-quality-9", "_type": "block", "style": "h2", "children": [{"_key": "page-print-quality-9-9", "_type": "span", "text": "Care", "marks": []}], "markDefs": []}, {"_key": "page-print-quality-10", "_type": "block", "style": "normal", "children": [{"_key": "page-print-quality-10-10", "_type": "span", "text": "Keep prints away from direct sun, moisture, and heat. Handle the paper with clean dry hands, or leave it in its protective packaging until framing.", "marks": []}], "markDefs": []}, {"_key": "page-print-quality-11", "_type": "block", "style": "normal", "children": [{"_key": "page-print-quality-11-11", "_type": "span", "text": "Use the size guide", "marks": ["link-page-print-quality-11-12"]}, {"_key": "page-print-quality-11-13", "_type": "span", "text": " before choosing a print, especially for large walls or square pieces.", "marks": []}], "markDefs": [{"_key": "link-page-print-quality-11-12", "_type": "link", "url": "/pages/size-guide"}]}], "seo": {"metaTitle": "Print Quality - Kumachi Prints", "metaDescription": "Learn about Kumachi Prints archival matte paper, pigment ink, unframed launch format, and print care."}}
{"_id": "page-size-guide", "_type": "page", "title": "Size Guide", "slug": {"_type": "slug", "current": "size-guide"}, "body": [{"_key": "page-size-guide-0", "_type": "block", "style": "h1", "children": [{"_key": "page-size-guide-0-0", "_type": "span", "text": "Size Guide", "marks": []}], "markDefs": []}, {"_key": "page-size-guide-1", "_type": "block", "style": "normal", "children": [{"_key": "page-size-guide-1-1", "_type": "span", "text": "Choose size by wall, frame, and presence.", "marks": []}], "markDefs": []}, {"_key": "page-size-guide-2", "_type": "block", "style": "normal", "children": [{"_key": "page-size-guide-2-2", "_type": "span", "text": "A small print can hold a desk, shelf, or gallery wall. A large print changes a room. The right size is not always the largest one, but the piece should have enough space to speak.", "marks": []}], "markDefs": []}, {"_key": "page-size-guide-3", "_type": "block", "style": "h2", "children": [{"_key": "page-size-guide-3-3", "_type": "span", "text": "Common Launch Ratios", "marks": []}], "markDefs": []}, {"_key": "page-size-guide-4", "_type": "block", "style": "normal", "children": [{"_key": "page-size-guide-4-4", "_type": "span", "text": "Square prints fit sizes like 10x10, 12x12, 16x16, 20x20, 24x24, and 28x28. Start with ", "marks": []}, {"_key": "page-size-guide-4-5", "_type": "span", "text": "Silence In Spirit", "marks": ["link-page-size-guide-4-6"]}, {"_key": "page-size-guide-4-7", "_type": "span", "text": ".", "marks": []}], "markDefs": [{"_key": "link-page-size-guide-4-6", "_type": "link", "url": "/products/silence-in-spirit"}], "listItem": "bullet"}, {"_key": "page-size-guide-5", "_type": "block", "style": "normal", "children": [{"_key": "page-size-guide-5-8", "_type": "span", "text": "3:4 prints fit sizes like 12x16, 18x24, and 30x40. Start with ", "marks": []}, {"_key": "page-size-guide-5-9", "_type": "span", "text": "African Equine Grace", "marks": ["link-page-size-guide-5-10"]}, {"_key": "page-size-guide-5-11", "_type": "span", "text": ".", "marks": []}], "markDefs": [{"_key": "link-page-size-guide-5-10", "_type": "link", "url": "/products/african-equine-grace"}], "listItem": "bullet"}, {"_key": "page-size-guide-6", "_type": "block", "style": "normal", "children": [{"_key": "page-size-guide-6-12", "_type": "span", "text": "2:3 prints fit sizes like 8x12, 12x18, 16x24, and 24x36. Start with ", "marks": []}, {"_key": "page-size-guide-6-13", "_type": "span", "text": "African Warrior", "marks": ["link-page-size-guide-6-14"]}, {"_key": "page-size-guide-6-15", "_type": "span", "text": ".", "marks": []}], "markDefs": [{"_key": "link-page-size-guide-6-14", "_type": "link", "url": "/products/african-warrior"}], "listItem": "bullet"}, {"_key": "page-size-guide-7", "_type": "block", "style": "normal", "children": [{"_key": "page-size-guide-7-16", "_type": "span", "text": "Tall and wide specialty prints fit sizes like 8x20, 10x24, 20x30, and 28x40. Start with ", "marks": []}, {"_key": "page-size-guide-7-17", "_type": "span", "text": "Majestic Monarch", "marks": ["link-page-size-guide-7-18"]}, {"_key": "page-size-guide-7-19", "_type": "span", "text": ".", "marks": []}], "markDefs": [{"_key": "link-page-size-guide-7-18", "_type": "link", "url": "/products/majestic-monarch"}], "listItem": "bullet"}, {"_key": "page-size-guide-8", "_type": "block", "style": "h2", "children": [{"_key": "page-size-guide-8-20", "_type": "span", "text": "Room Guidance", "marks": []}], "markDefs": []}, {"_key": "page-size-guide-9", "_type": "block", "style": "normal", "children": [{"_key": "page-size-guide-9-21", "_type": "span", "text": "Above a sofa, bed, or sideboard, choose a print that feels close to two-thirds of the furniture width. In a hallway or reading corner, a smaller piece can work if the image has enough contrast and quiet around it.", "marks": []}], "markDefs": []}, {"_key": "page-size-guide-10", "_type": "block", "style": "h2", "children": [{"_key": "page-size-guide-10-22", "_type": "span", "text": "Frame Guidance", "marks": []}], "markDefs": []}, {"_key": "page-size-guide-11", "_type": "block", "style": "normal", "children": [{"_key": "page-size-guide-11-23", "_type": "span", "text": "Check the exact print size before buying a frame. Aspect ratio matters: a 12x16 print and an 18x24 print share a shape, but a square print will need a square frame.", "marks": []}], "markDefs": []}, {"_key": "page-size-guide-12", "_type": "block", "style": "normal", "children": [{"_key": "page-size-guide-12-24", "_type": "span", "text": "When in doubt, choose the size you can frame well. A print in the right frame will carry more authority than a large print treated carelessly.", "marks": []}], "markDefs": []}, {"_key": "page-size-guide-13", "_type": "block", "style": "normal", "children": [{"_key": "page-size-guide-13-25", "_type": "span", "text": "See print quality", "marks": ["link-page-size-guide-13-26"]}, {"_key": "page-size-guide-13-27", "_type": "span", "text": " or ", "marks": []}, {"_key": "page-size-guide-13-28", "_type": "span", "text": "shop the Opening Drop", "marks": ["link-page-size-guide-13-29"]}, {"_key": "page-size-guide-13-30", "_type": "span", "text": ".", "marks": []}], "markDefs": [{"_key": "link-page-size-guide-13-26", "_type": "link", "url": "/pages/print-quality"}, {"_key": "link-page-size-guide-13-29", "_type": "link", "url": "/blog/drops/opening-drop"}]}], "seo": {"metaTitle": "Size Guide - Kumachi Prints", "metaDescription": "Choose the right Kumachi Prints size by wall, room, frame, and aspect ratio."}}
{"_id": "page-faq", "_type": "page", "title": "FAQ", "slug": {"_type": "slug", "current": "faq"}, "body": [{"_key": "page-faq-0", "_type": "block", "style": "h1", "children": [{"_key": "page-faq-0-0", "_type": "span", "text": "FAQ", "marks": []}], "markDefs": []}, {"_key": "page-faq-1", "_type": "block", "style": "h2", "children": [{"_key": "page-faq-1-1", "_type": "span", "text": "Are the Opening Drop prints limited editions?", "marks": []}], "markDefs": []}, {"_key": "page-faq-2", "_type": "block", "style": "normal", "children": [{"_key": "page-faq-2-2", "_type": "span", "text": "No. The Opening Drop is a curated open drop. The work is selected and launched together, but it is not being sold with edition numbers or false scarcity.", "marks": []}], "markDefs": []}, {"_key": "page-faq-3", "_type": "block", "style": "h2", "children": [{"_key": "page-faq-3-3", "_type": "span", "text": "What paper do you use?", "marks": []}], "markDefs": []}, {"_key": "page-faq-4", "_type": "block", "style": "normal", "children": [{"_key": "page-faq-4-4", "_type": "span", "text": "Launch prints are produced on archival matte paper with pigment ink.", "marks": []}], "markDefs": []}, {"_key": "page-faq-5", "_type": "block", "style": "h2", "children": [{"_key": "page-faq-5-5", "_type": "span", "text": "Do prints come framed?", "marks": []}], "markDefs": []}, {"_key": "page-faq-6", "_type": "block", "style": "normal", "children": [{"_key": "page-faq-6-6", "_type": "span", "text": "Launch prints ship unframed. This keeps shipping simpler and lets each collector choose the frame that fits the room.", "marks": []}], "markDefs": []}, {"_key": "page-faq-7", "_type": "block", "style": "h2", "children": [{"_key": "page-faq-7-7", "_type": "span", "text": "How do I choose a size?", "marks": []}], "markDefs": []}, {"_key": "page-faq-8", "_type": "block", "style": "normal", "children": [{"_key": "page-faq-8-8", "_type": "span", "text": "Start with the wall and the frame. Use the ", "marks": []}, {"_k